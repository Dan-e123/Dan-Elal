<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:id="@+id/main"
    >

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="דמות השראה-אמא שלי"
        android:textSize="35sp" />

    <ImageView
        android:id="@+id/imgMom"
        android:layout_width="248dp"
        android:layout_height="212dp"
        android:layout_marginTop="20dp"
        android:contentDescription="תמונה של אמא שלי"
        android:scaleType="centerCrop"
        android:src="@drawable/img" />

    <TextView
        android:id="@+id/Description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="אני בחרתי באמא שלי כדמות השראה בשבילי כי היא הבן אדם הכי טוב שאני מכירה וכל יום אני לומדת ממנה עוד על איך להיות בן אדם יותר טוב וחוץ מזה היא הבן אדם שהכי מצחיק אותי ושאני יכולה לדבר איתה על הכל ואנ אוהבת אותה."
        android:textSize="20sp" />
    <Button
        android:id="@+id/btnClick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/click_here" />

</LinearLayout>